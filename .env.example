# Copy to .env and fill in real values (values are in the hosted deployment's env settings).
# All keys must be prefixed VITE_ to be exposed to the client by Vite.

# Backend API — must include the /api/v1 prefix (local: http://localhost:8080/api/v1)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Initial map view
VITE_DEFAULT_MAP_LAT=46.8721
VITE_DEFAULT_MAP_LNG=-113.9940
VITE_DEFAULT_MAP_ZOOM=12

# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Google OAuth web client ID (Firebase console → Auth → Google → Web SDK configuration).
# The app's origins must be in this client's "Authorized JavaScript origins" (GCP console).
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# Mapbox public access token (account.mapbox.com → Access tokens, pk.*)
VITE_MAPBOX_TOKEN=pk.your-mapbox-token
